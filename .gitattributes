# Line endings normalized to LF in the repository: the project runs on Windows,
# macOS and Linux, and without this each system would rewrite the other's files,
# making lines nobody touched look modified.
* text=auto eol=lf

# Windows scripts want CRLF to really work.
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.bat text eol=crlf

# Binaries: never touch.
*.onnx binary
*.bin  binary
*.png  binary
*.ico  binary
*.wav  binary
