# Copia questo file in ".env" e modifica cio' che ti serve.
# Tutte le variabili sono opzionali: senza .env valgono i default.
# Quasi tutto si cambia anche dal pannello (scheda "Motori"): le modifiche
# fatte li' finiscono proprio in questo file.

# --- Server -------------------------------------------------------------
DC_HOST=127.0.0.1
DC_PORT=8770
DC_LOG_LEVEL=info

# --- Cervello -----------------------------------------------------------
# Agenti (hanno memoria e strumenti propri; Tsukumo ne e' la voce):
#   claude_code = Claude Code gia' installato e autenticato (abbonamento Claude)
#   codex       = Codex CLI o quello dell'estensione di VS Code (account ChatGPT)
#   openclaw    = il tuo agente OpenClaw, via il Gateway locale
#   hermes      = Hermes Agent con l'API server attivo
#   command     = qualunque programma da riga di comando
# Sul tuo computer:
#   openai = LM Studio, llama.cpp server, vLLM, ... (API stile OpenAI)
#   ollama = modelli serviti da Ollama
# In rete (serve una chiave):
#   anthropic, gemini, groq, openrouter, deepseek, mistral, together
# Di prova:
#   mock = risposte preconfezionate, nessun modello
DC_LLM_BACKEND=ollama
DC_OLLAMA_URL=http://127.0.0.1:11434
DC_OLLAMA_MODEL=llama3.2

# LM Studio: con DC_OPENAI_MODEL=auto usa il modello gia' caricato.
# DC_LLM_BACKEND=openai
# DC_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# DC_OPENAI_MODEL=auto

# Claude Code: di default puo' solo cercare sul web e leggere file.
# DC_LLM_BACKEND=claude_code
# DC_CLAUDE_CODE_MODEL=              # vuoto = quello del tuo account (haiku, sonnet, opus)
# DC_CLAUDE_CODE_CWD=                # cartella che puo' leggere (vuoto = la tua cartella utente)
# DC_CLAUDE_CODE_TOOLS=WebSearch,WebFetch,Read,Glob,Grep

# Codex: se non e' nel PATH viene cercato nell'estensione di VS Code.
# DC_LLM_BACKEND=codex
# DC_CODEX_SANDBOX=read-only

# OpenClaw: stessa personalita', memoria e tool del tuo agente. Meglio un
# agente dedicato con pochi tool (vedi README). Il token si legge da solo da
# ~/.openclaw/openclaw.json; DC_OPENCLAW_TOKEN solo per sovrascriverlo.
# DC_LLM_BACKEND=openclaw
# DC_OPENCLAW_URL=http://127.0.0.1:18789
# DC_OPENCLAW_AGENT_ID=companion

# Hermes Agent (API_SERVER_ENABLED=true nel suo .env):
# DC_LLM_BACKEND=hermes
# DC_HERMES_BASE_URL=http://127.0.0.1:8642/v1

# Un agente qualsiasi: {prompt} diventa il messaggio, altrimenti va sullo stdin.
# DC_LLM_BACKEND=command
# DC_AGENT_COMMAND=hermes chat -q {prompt}

# Servizi in rete: ognuno ha DC_<NOME>_API_KEY, DC_<NOME>_MODEL, DC_<NOME>_BASE_URL.
# DC_LLM_BACKEND=anthropic
# DC_ANTHROPIC_API_KEY=sk-ant-...
# DC_ANTHROPIC_MODEL=claude-opus-5

DC_TEMPERATURE=0.7
DC_HISTORY_TURNS=12
# Se il cervello non risponde: 0 = mostra l'errore e come rimediare (default),
# 1 = rispondi con frasi preconfezionate (nasconde il problema).
DC_LLM_FALLBACK=0
# Ogni quanti secondi controllare che cervello e voce rispondano.
DC_STATUS_INTERVAL=10

# --- Voce ---------------------------------------------------------------
# Locali:  kokoro (default) | kokoro_http | piper | system | formant (prova)
# In rete: elevenlabs | openai_tts | azure | google_tts | cartesia | edge (senza chiave)
# I motori oltre a kokoro/formant e a quelli in rete con chiave vogliono un
# pacchetto in piu': vedi "Provider opzionali" in requirements.txt.
DC_TTS_ENGINE=kokoro
DC_KOKORO_MODEL=models/kokoro-v1.0.onnx
DC_KOKORO_VOICES=models/voices-v1.0.bin
DC_KOKORO_HTTP_URL=http://127.0.0.1:8880
# Voce Kokoro (af_heart = inglese, if_sara = italiano, ...)
DC_VOICE=af_heart
DC_SPEED=1.0
# Pronuncia di riserva, se il nome della voce non dice la lingua.
DC_LANGUAGE=en-us
# In che lingua risponde: auto = quella della voce (una voce inglese legge
# male l'italiano; con una voce multilingua risponde nella tua lingua),
# same = quella in cui scrivi, oppure English / it / ...
DC_REPLY_LANGUAGE=auto
DC_TTS_FALLBACK=1

# Ogni motore ha la sua voce (un nome Kokoro non vale altrove):
# DC_TTS_ENGINE=elevenlabs
# DC_ELEVENLABS_API_KEY=...
# DC_ELEVENLABS_VOICE=Rachel
# DC_ELEVENLABS_MODEL=eleven_flash_v2_5
#
# DC_TTS_ENGINE=openai_tts
# DC_OPENAI_TTS_API_KEY=sk-...
# DC_OPENAI_TTS_VOICE=coral
# DC_OPENAI_TTS_INSTRUCTIONS=Parla in modo caldo e allegro.
#
# DC_TTS_ENGINE=azure
# DC_AZURE_SPEECH_KEY=...
# DC_AZURE_SPEECH_REGION=westeurope
# DC_AZURE_SPEECH_VOICE=it-IT-IsabellaMultilingualNeural
#
# DC_TTS_ENGINE=edge
# DC_EDGE_VOICE=it-IT-ElsaNeural

# --- Ascolto: parlare al companion --------------------------------------
# none            = solo tastiera (default)
# faster_whisper  = riconoscimento locale, consigliato (pip install faster-whisper)
# whisper_cpp     = un server whisper.cpp gia' avviato
# openai_whisper_api = trascrizione remota (serve una chiave)
# browser         = riconoscimento di Chrome/Electron, passa da Google
DC_STT_ENGINE=none
# DC_WHISPER_MODEL=base          # tiny | base | small | medium | large-v3
# DC_WHISPER_DEVICE=auto         # auto | cpu | cuda
# DC_WHISPER_LANGUAGE=auto       # indicarla e' piu' rapido e preciso

# Come si prende la parola:
#   push = premi e parla (default)   vad = sempre in ascolto   wake = a chiamata
DC_VOICE_MODE=push
# Tasto globale del push-to-talk. Fuori dalla finestra fa da interruttore
# (Electron non sa dire quando una scorciatoia globale viene rilasciata);
# con la finestra a fuoco il tieni-premuto funziona davvero.
DC_PUSH_TO_TALK_KEY=Control+Space
# Solo con DC_VOICE_MODE=wake
DC_WAKE_WORD=companion
# Quanto silenzio (secondi) chiude la frase quando e' sempre in ascolto
DC_VAD_SILENCE=0.8
# Sotto questa energia (0..1) il microfono e' considerato muto
DC_VAD_THRESHOLD=0.02
# Parlargli sopra lo interrompe (1 = si)
DC_VOICE_INTERRUPT=1

# --- Lip-sync -----------------------------------------------------------
# Guadagno applicato all'apertura della bocca (1.0 = neutro)
DC_VISEME_GAIN=1.15
# Soglia (0..1) sotto la quale l'audio e' considerato silenzio
DC_VISEME_SILENCE=0.07

# --- Personalita' -------------------------------------------------------
# Vale per i modelli; gli agenti hanno la loro.
# DC_SYSTEM_PROMPT=Sei Tsukumo, una piccola compagna da scrivania. Rispondi in massimo tre frasi brevi.
