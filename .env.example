# Copy this file to ".env" and change what you need.
# Every variable is optional: without a .env the defaults apply.
# Almost everything can also be changed from the panel ("Engines" tab): the
# changes made there end up in this very file.

# --- Server -------------------------------------------------------------
DC_HOST=127.0.0.1
DC_PORT=8770
DC_LOG_LEVEL=info
# Security (see SECURITY.md). Tsukumo's pages are on the backend's own
# origin: usually nothing is needed here.
# An address other than 127.0.0.1 in DC_HOST opens the backend to the network:
# other devices need the token written in state/access_token.
# DC_ALLOWED_HOSTS=pc.tailnet.ts.net    # extra names accepted in the Host header
# DC_CORS_ORIGINS=                      # other browser origins ("*" is ignored)

# --- Brain --------------------------------------------------------------
# Agents (they have their own memory and tools; Tsukumo is their voice):
#   claude_code = Claude Code already installed and signed in (Claude subscription)
#   codex       = Codex CLI or the one in the VS Code extension (ChatGPT account)
#   openclaw    = your OpenClaw agent, through the local Gateway
#   hermes      = Hermes Agent with its API server on
#   command     = any command-line program
# On your computer:
#   openai = LM Studio, llama.cpp server, vLLM, ... (OpenAI-style API)
#   ollama = models served by Ollama
# Online (a key is needed):
#   anthropic, gemini, groq, openrouter, deepseek, mistral, together
#   g4f = GPT4Free, no key: needs `g4f api --bind 127.0.0.1:1337 --no-gui`
# For testing:
#   mock = canned answers, no model
# Without DC_LLM_BACKEND, at first start Tsukumo uses the first brain it finds
# on the PC, in this order: claude_code, codex, openclaw, ollama, openai
# (LM Studio). The choice is then saved here. None found = ollama.
# DC_LLM_BACKEND=ollama
DC_OLLAMA_URL=http://127.0.0.1:11434
DC_OLLAMA_MODEL=llama3.2

# LM Studio: with DC_OPENAI_MODEL=auto it uses the model already loaded.
# DC_LLM_BACKEND=openai
# DC_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# DC_OPENAI_MODEL=auto

# Claude Code: by default it can only search the web and read files.
# DC_LLM_BACKEND=claude_code
# DC_CLAUDE_CODE_MODEL=              # empty = your account's (haiku, sonnet, opus)
# DC_CLAUDE_CODE_CWD=                # folder it can read (empty = your user folder)
# DC_CLAUDE_CODE_TOOLS=WebSearch,WebFetch,Read,Glob,Grep

# Codex: if it's not in the PATH it's looked for in the VS Code extension.
# DC_LLM_BACKEND=codex
# DC_CODEX_SANDBOX=read-only

# OpenClaw: the same personality, memory and tools as your agent. Better a
# dedicated agent with few tools (see README). The token is read by itself from
# ~/.openclaw/openclaw.json; DC_OPENCLAW_TOKEN only to override it.
# DC_LLM_BACKEND=openclaw
# DC_OPENCLAW_URL=http://127.0.0.1:18789
# DC_OPENCLAW_AGENT_ID=companion

# Hermes Agent (API_SERVER_ENABLED=true in its .env):
# DC_LLM_BACKEND=hermes
# DC_HERMES_BASE_URL=http://127.0.0.1:8642/v1

# Any agent: {prompt} becomes the message, otherwise it goes to stdin.
# DC_LLM_BACKEND=command
# DC_AGENT_COMMAND=hermes chat -q {prompt}

# Online services: each one has DC_<NAME>_API_KEY, DC_<NAME>_MODEL, DC_<NAME>_BASE_URL.
# DC_LLM_BACKEND=anthropic
# DC_ANTHROPIC_API_KEY=sk-ant-...
# DC_ANTHROPIC_MODEL=claude-opus-5

DC_TEMPERATURE=0.7
DC_HISTORY_TURNS=12
# If the brain doesn't answer: 0 = show the error and how to fix it (default),
# 1 = answer with canned sentences (hides the problem).
DC_LLM_FALLBACK=0
# How often (seconds) to check that brain and voice answer.
DC_STATUS_INTERVAL=10
# Look for the installed brains at start ("Found on the PC" badge in the panel).
DC_DETECT_ENGINES=1

# --- Voice --------------------------------------------------------------
# Local:  kokoro (default) | kokoro_http | piper | system | formant (test)
# Online: elevenlabs | openai_tts | azure | google_tts | cartesia | edge (no key)
# Engines other than kokoro/formant and the online ones with a key want an
# extra package: see "Optional providers" in requirements.txt.
DC_TTS_ENGINE=kokoro
DC_KOKORO_MODEL=models/kokoro-v1.0.onnx
DC_KOKORO_VOICES=models/voices-v1.0.bin
DC_KOKORO_HTTP_URL=http://127.0.0.1:8880
# Kokoro voice (af_heart = English, if_sara = Italian, ...). If missing, she
# starts with a voice in the system's language (Windows in Italian -> if_sara);
# a voice chosen in the panel wins over this one anyway.
# DC_VOICE=af_heart
# DC_SYSTEM_LANGUAGE=it
DC_SPEED=1.0
# Fallback pronunciation, if the voice's name doesn't tell the language.
DC_LANGUAGE=en-us
# Which language she answers in: auto = the voice's (an English voice reads
# Italian badly; with a multilingual voice she answers in your language),
# same = the one you write in, or English / it / ...
DC_REPLY_LANGUAGE=auto
DC_TTS_FALLBACK=1

# Each engine has its own voice (a Kokoro name isn't valid elsewhere):
# DC_TTS_ENGINE=elevenlabs
# DC_ELEVENLABS_API_KEY=...
# DC_ELEVENLABS_VOICE=Rachel
# DC_ELEVENLABS_MODEL=eleven_flash_v2_5
#
# DC_TTS_ENGINE=openai_tts
# DC_OPENAI_TTS_API_KEY=sk-...
# DC_OPENAI_TTS_VOICE=coral
# DC_OPENAI_TTS_INSTRUCTIONS=Speak in a warm, cheerful way.
#
# DC_TTS_ENGINE=azure
# DC_AZURE_SPEECH_KEY=...
# DC_AZURE_SPEECH_REGION=westeurope
# DC_AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
#
# DC_TTS_ENGINE=edge
# DC_EDGE_VOICE=en-US-AvaNeural

# --- Listening: talking to the companion --------------------------------
# none            = keyboard only (default)
# faster_whisper  = local recognition, recommended (pip install faster-whisper)
# whisper_cpp     = a whisper.cpp server already running
# openai_whisper_api = remote transcription (a key is needed)
# browser         = Chrome/Electron recognition, goes through Google
DC_STT_ENGINE=none
# DC_WHISPER_MODEL=base          # tiny | base | small | medium | large-v3
# DC_WHISPER_DEVICE=auto         # auto | cpu | cuda
# DC_WHISPER_LANGUAGE=auto       # setting it is faster and more accurate

# How you take the floor:
#   push = push to talk (default)   vad = always listening   wake = on call
DC_VOICE_MODE=push
# Global push-to-talk key. Outside the window it works as a toggle
# (Electron can't tell when a global shortcut is released);
# with the window focused holding it down really works.
DC_PUSH_TO_TALK_KEY=Control+Space
# Only with DC_VOICE_MODE=wake
DC_WAKE_WORD=companion
# How much silence (seconds) ends the sentence when always listening
DC_VAD_SILENCE=0.8
# Below this energy (0..1) the microphone is considered silent
DC_VAD_THRESHOLD=0.02
# Talking over her interrupts her (1 = yes)
DC_VOICE_INTERRUPT=1

# --- Lip-sync -----------------------------------------------------------
# Gain applied to the mouth opening (1.0 = neutral)
DC_VISEME_GAIN=1.15
# Threshold (0..1) below which the audio counts as silence
DC_VISEME_SILENCE=0.07

# --- Personality --------------------------------------------------------
# Applies to models; agents have their own.
# DC_SYSTEM_PROMPT=You are Tsukumo, a little desk companion. Answer in at most three short sentences.
