# Copia questo file in ".env" e modifica cio' che ti serve.
# Tutte le variabili sono opzionali: senza .env valgono i default.

# --- Server -------------------------------------------------------------
DC_HOST=127.0.0.1
DC_PORT=8770
DC_LOG_LEVEL=info

# --- LLM ----------------------------------------------------------------
# Tutto quello che segue si puo' anche cambiare dal pannello, scheda "Motori":
# le modifiche fatte li' finiscono proprio in questo file.
#
# Locali (niente rete, niente chiavi):
#   ollama   = modello locale via Ollama
#   openai   = server locale con API stile OpenAI: LM Studio, llama.cpp
#              server, vLLM, text-generation-webui, ...
#   openclaw = il companion diventa la voce del tuo agente OpenClaw
#   mock     = risponditore offline integrato, nessun modello richiesto
# Cloud (servono una chiave e una connessione):
#   anthropic, gemini, groq, openrouter, deepseek, mistral, together
DC_LLM_BACKEND=ollama
DC_OLLAMA_URL=http://127.0.0.1:11434
DC_OLLAMA_MODEL=llama3.2

# Per LM Studio (o un altro server "openai"): scommenta queste e imposta
# DC_LLM_BACKEND=openai. Con DC_OPENAI_MODEL=auto usa il primo modello
# che il server ha gia' caricato, quindi di solito non serve cambiarlo.
# DC_LLM_BACKEND=openai
# DC_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# DC_OPENAI_MODEL=auto

# Per far parlare il companion come il tuo agente OpenClaw vero (stessa
# personalita', memoria persistente, stessi tool): DC_LLM_BACKEND=openclaw.
# Il token si legge da solo da ~/.openclaw/openclaw.json; imposta
# DC_OPENCLAW_TOKEN solo se vuoi sovrascriverlo.
# Meglio un agente dedicato che condivide il workspace di "main" ma con pochi
# tool: stessa personalita' e memoria, prompt molto piu' corto (vedi README).
# DC_LLM_BACKEND=openclaw
# DC_OPENCLAW_AGENT_ID=companion

# Per un servizio cloud: scegli il backend e metti la sua chiave. Ogni
# provider ha le sue tre variabili, tutte con lo stesso schema.
# DC_LLM_BACKEND=anthropic
# DC_ANTHROPIC_API_KEY=sk-ant-...
# DC_ANTHROPIC_MODEL=claude-opus-5
#
# DC_LLM_BACKEND=gemini
# DC_GEMINI_API_KEY=...
# DC_GEMINI_MODEL=gemini-2.0-flash
#
# Groq, OpenRouter, DeepSeek, Mistral e Together parlano l'API OpenAI, quindi
# seguono lo stesso schema: DC_<NOME>_API_KEY, DC_<NOME>_MODEL, DC_<NOME>_BASE_URL.
# DC_LLM_BACKEND=groq
# DC_GROQ_API_KEY=gsk_...

DC_TEMPERATURE=0.7
DC_HISTORY_TURNS=12
# Se l'LLM non risponde, rispondi comunque con il mock (1 = si)
DC_LLM_FALLBACK=1

# --- TTS ----------------------------------------------------------------
# Locali:  kokoro (default) | kokoro_http | piper | system | formant (test)
# In rete: edge (senza chiave) | elevenlabs (a consumo)
# I motori oltre a kokoro/formant vogliono un pacchetto in piu': vedi
# la sezione "Provider opzionali" di requirements.txt.
DC_TTS_ENGINE=kokoro
DC_KOKORO_MODEL=models/kokoro-v1.0.onnx
DC_KOKORO_VOICES=models/voices-v1.0.bin
DC_KOKORO_HTTP_URL=http://127.0.0.1:8880
DC_VOICE=af_heart
DC_SPEED=1.0
# Pronuncia di riserva: di solito la dice gia' il nome della voce
# (af_heart = inglese, if_sara = italiano, ...).
# en-us, en-gb, it, fr-fr, es, pt-br, ja, ko, cmn, hi
DC_LANGUAGE=en-us
# In che lingua risponde: auto = quella della voce (una voce inglese legge
# male l'italiano), same = quella in cui scrivi, oppure English / it / ...
DC_REPLY_LANGUAGE=auto
DC_TTS_FALLBACK=1

# Voci degli altri motori (ognuno ha le proprie: un nome Kokoro non vale altrove)
# DC_TTS_ENGINE=edge
# DC_EDGE_VOICE=it-IT-ElsaNeural
# DC_TTS_ENGINE=piper
# DC_PIPER_MODEL=models/piper/it_IT-riccardo-x_low.onnx
# DC_TTS_ENGINE=elevenlabs
# DC_ELEVENLABS_API_KEY=...
# DC_ELEVENLABS_VOICE=Rachel

# --- Voce: parlare al companion -----------------------------------------
# none            = solo tastiera (default)
# faster_whisper  = riconoscimento locale, consigliato (pip install faster-whisper)
# whisper_cpp     = un server whisper.cpp gia' avviato
# openai_whisper_api = trascrizione remota (serve una chiave)
# browser         = riconoscimento di Chrome/Electron, passa da Google
DC_STT_ENGINE=none
# DC_WHISPER_MODEL=base          # tiny | base | small | medium | large-v3
# DC_WHISPER_DEVICE=auto         # auto | cpu | cuda
# DC_WHISPER_LANGUAGE=auto       # indicarla e' piu' rapido e preciso

# Come si prende la parola:
#   push = premi e parla (default)   vad = sempre in ascolto   wake = a chiamata
DC_VOICE_MODE=push
# Tasto globale del push-to-talk. Fuori dalla finestra fa da interruttore
# (Electron non sa dire quando una scorciatoia globale viene rilasciata);
# con la finestra a fuoco il tieni-premuto funziona davvero.
DC_PUSH_TO_TALK_KEY=Control+Space
# Solo con DC_VOICE_MODE=wake
DC_WAKE_WORD=companion
# Quanto silenzio (secondi) chiude la frase quando e' sempre in ascolto
DC_VAD_SILENCE=0.8
# Sotto questa energia (0..1) il microfono e' considerato muto
DC_VAD_THRESHOLD=0.02
# Parlargli sopra lo interrompe (1 = si)
DC_VOICE_INTERRUPT=1

# --- OpenClaw -----------------------------------------------------------
# Spia verde/rossa del Gateway OpenClaw in alto a sinistra.
# 0 per nasconderla del tutto.
DC_OPENCLAW_ENABLED=1
DC_OPENCLAW_URL=http://127.0.0.1:18789
# Ogni quanti secondi sondare il Gateway
DC_OPENCLAW_INTERVAL=5

# --- Lip-sync -----------------------------------------------------------
# Guadagno applicato all'apertura della bocca (1.0 = neutro)
DC_VISEME_GAIN=1.15
# Soglia (0..1) sotto la quale l'audio e' considerato silenzio
DC_VISEME_SILENCE=0.07

# --- Personalita' -------------------------------------------------------
# DC_SYSTEM_PROMPT=Sei un piccolo compagno da scrivania. Rispondi in massimo tre frasi brevi.
