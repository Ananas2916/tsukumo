{
  "name": "tsukumo",
  "productName": "Tsukumo",
  "version": "3.0.0",
  "private": true,
  "description": "Tsukumo's desktop shell (Electron): starts the Python backend and shows her as a frameless, always-on-top companion.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:devtools": "cross-env DC_DEVTOOLS=1 electron .",
    "start:attach": "cross-env DC_NO_SPAWN=1 electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  },
  "build": {
    "appId": "app.tsukumo.desktop",
    "productName": "Tsukumo",
    "copyright": "Tsukumo",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "i18n.js",
      "desktop.js",
      "pet-physics.js",
      "spotify.js",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/app",
        "to": "tsukumo"
      },
      {
        "from": "../build/python",
        "to": "python"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tsukumo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
